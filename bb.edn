{:paths ["scripts"]
 :deps {tmux-dev/tmux-dev {:git/url "https://github.com/floscr/tmux-dev"
                            :git/sha "6ef67ed56540a60b6862c656b6098139e1e6e82f"}}
 :tasks
 {:requires ([tmux-dev.core :as td]
             [clojure.edn :as edn]
             [clojure.string :as str])
  :init (do
          (defn xi-config-file [name]
            (str (System/getProperty "user.home") "/.config/xi/" name))
          (defn read-xi-edn [name]
            (let [f (java.io.File. (xi-config-file name))]
              (if (.exists f) (edn/read-string (slurp f)) {})))
          (defn write-xi-edn [name m]
            (.mkdirs (.getParentFile (java.io.File. (xi-config-file name))))
            (spit (xi-config-file name) (str (pr-str m) "\n")))
          (defn fmt-ts [ms]
            (when ms (str (java.util.Date. (long ms)))))
          ;; Host for the printed "Web: http://…" URLs: $XI_PUBLIC_HOST when
          ;; set. The server binds all interfaces unless $XI_HOST narrows it,
          ;; so unless XI_HOST is loopback the Tailscale IP is tried (when the
          ;; tailscale CLI is installed and its daemon is up); else localhost.
          ;; Purely cosmetic, so a missing/stopped tailscale must never block
          ;; serve / serve:restart.
          (defn host-ip []
            (let [bind (clojure.string/trim (or (System/getenv "XI_HOST") ""))
                  remote? (not (contains? #{"127.0.0.1" "localhost" "::1"} bind))]
              (or (not-empty (clojure.string/trim (or (System/getenv "XI_PUBLIC_HOST") "")))
                  (when remote?
                    (try (-> (shell {:out :string :err :string :continue true} "tailscale" "ip" "-4")
                             :out clojure.string/trim not-empty)
                         (catch Exception _ nil)))
                  "localhost")))
          (def config {:session "xi"
                       :windows [["watch" "npx shadow-cljs watch main web"]]
                       :print   ["Web: http://localhost:7474"]})
          ;; Persist the headless server's stdout+stderr to a logfile so a
          ;; crash trace survives a `bb serve:restart` (the tmux pane scrollback
          ;; is overwritten on restart, and there is no other log). Logs go to
          ;; /tmp so they are temporal — self-cleaned on machine reboot — and
          ;; out of ~/.config. `tee -a` appends across restarts (each run marked
          ;; by a banner); bun's argv is unchanged (`… --headless`) so
          ;; reap-stray-serve!'s `--headless$` pgrep still matches only the real
          ;; server, not the `tee`/wrapper shell.
          (def serve-log "/tmp/xi-serve.log")
          ;; The banner must stay a SINGLE physical line: tmux send-keys turns a
          ;; literal newline into Enter, which would split the command at the
          ;; prompt. printf escapes the blank separator line instead.
          (defn logged [cmd log]
            (str "printf '\\n=== xi-serve start %s ===\\n' \"$(date -Is)\" >> " log "; "
                 cmd " 2>&1 | tee -a " log))
          (def serve-config {:session "xi-serve"
                             ;; The server window waits for the new watch's first
                             ;; build (serve:await-build): both windows start
                             ;; together, and bun would otherwise boot the
                             ;; PREVIOUS watch's target/main.js — stale code +
                             ;; a "Stale Output!" devtools token mismatch.
                             :windows [["watch" "npx shadow-cljs watch main web"]
                                       ["server" (str "bb serve:await-build; "
                                                     (logged "bun target/main.js server --headless" serve-log))]]
                             :env-file ".env"})
          (def pa-serve-config {:session "xi-pa"
                                :windows [["server" "bun target/main.js server --headless --agent root --port 7475"]]})
          ;; Isolated demo server (port 7476). HOME is redirected at .demo-home
          ;; (built by scripts/demo-seed.mjs) so it never sees the real active
          ;; session — see docs/demo.md. Reuses the target/main.js compiled by
          ;; the main watch (bb dev / bb serve).
          (def demo-home (str (System/getProperty "user.dir") "/.demo-home"))
          (def demo-config {:session "xi-demo"
                            ;; XDG_DATA_HOME too: user extensions keep their data
                            ;; there (xi.paths/extension-data-dir), and an inherited
                            ;; absolute XDG_DATA_HOME would point at the real one.
                            :windows [["server" (str "HOME=" demo-home
                                                     " XDG_DATA_HOME=" demo-home "/.local/share"
                                                     " bun target/main.js server --headless --port 7476")]]
                            :print ["Demo web: http://localhost:7476"]})
          ;; Reap leaked dev :7474 headless servers. `td/*` only manage the tmux
          ;; session, and the systemd xi-serve unit uses KillMode=process, so
          ;; detached/orphaned `bun target/main.js server --headless` processes
          ;; leak across restarts and keep :7474 occupied. The personal-agent
          ;; (--port 7475), demo (--port 7476) and system xi-agent
          ;; (--agent root) servers all carry --port/--agent and are
          ;; deliberately excluded.
          ;; The `--headless$` end-anchor matches ONLY the dev serve cmdline
          ;; (`bun target/main.js server --headless`); personal/demo/xi-agent
          ;; carry trailing --port/--agent args so they don't
          ;; match. pgrep returns just the PIDs, so no cmdline parsing is
          ;; needed (bb.edn is EDN — no #(...) / #"..." reader macros).
          (defn stray-pids [pattern]
            (let [{:keys [out]} (shell {:out :string :continue true}
                                       "pgrep" "-f" pattern)]
              (remove clojure.string/blank?
                      (clojure.string/split-lines (or out "")))))
          (defn reap! [what pattern]
            (when-let [pids (seq (stray-pids pattern))]
              (println (str "Reaping " (count pids) " stray xi " what " process(es): "
                            (clojure.string/join " " pids)))
              (apply shell {:continue true} "kill" "-9" pids)
              (Thread/sleep 500)))
          (defn reap-stray-serve! []
            (reap! "serve" "target/main.js server --headless$"))
          ;; The demo server leaks the same way (tmux session gone, bun still
          ;; holding :7476), so a demo:restart's fresh server can't bind.
          (defn reap-stray-demo! []
            (reap! "demo" "target/main.js server --headless --port 7476$"))
          ;; `bb dev` (session xi) and `bb serve` (session xi-serve) both run
          ;; `shadow-cljs watch main web`. There is one shadow server per
          ;; project and a build can only be watched once, so whichever starts
          ;; second dies with "already started {:build-id :main}". Starting or
          ;; restarting either one stops the other first.
          ;; Compile + run a :node-test build (autorun). Prints one line when
          ;; every test passes, else only the FAIL/ERROR blocks + summary
          ;; (exit 1); compile errors print the full output. `--full` streams
          ;; the raw shadow-cljs/cljs.test output instead.
          (defn run-cljs-tests [build]
            (if (some #{"--full"} *command-line-args*)
              (shell (str "npx shadow-cljs compile " build))
              (let [{:keys [out err]} (shell {:out :string :err :string :continue true}
                                             (str "npx shadow-cljs compile " build))
                    text    (str out "\n" err)
                    summary (re-find (re-pattern "Ran (\\d+) tests containing (\\d+) assertions\\.\\n(\\d+) failures, (\\d+) errors\\.") text)
                    [_ tests assertions failures errors] summary
                    ;; A FAIL/ERROR block runs from its header to the next blank line.
                    blocks  (->> (str/split-lines text)
                                 (reduce (fn [[blocks cur] line]
                                           (cond
                                             (re-find (re-pattern "^(FAIL|ERROR) in ") line) [(cond-> blocks cur (conj cur)) [line]]
                                             (and cur (str/blank? line))          [(conj blocks cur) nil]
                                             cur                                  [blocks (conj cur line)]
                                             :else                                [blocks nil]))
                                         [[] nil])
                                 ((fn [[blocks cur]] (cond-> blocks cur (conj cur)))))]
                (cond
                  (nil? summary)
                  (do (println text)
                      (println "✗ tests did not run (compile error or crash)")
                      (System/exit 1))

                  (= "0" failures errors)
                  (println (str "✓ " tests " tests passed (" assertions " assertions)"))

                  :else
                  (do (doseq [b blocks] (println (str/join "\n" b)) (println))
                      (println (str "✗ " failures " failures, " errors " errors (" tests " tests, " assertions " assertions)"))
                      (System/exit 1))))))
          (defn stop-dev-watch! []
            (td/stop config))
          (defn stop-serve-watch! []
            (td/stop serve-config)
            (reap-stray-serve!)))

  dev         {:doc "Start tmux dev session (stops the serve session — both run the shadow watch)"
               :task (do (stop-serve-watch!) (td/start config))}
  dev:stop    {:doc "Stop tmux dev session"
               :task (td/stop config)}
  dev:restart {:doc "Restart tmux dev session (stops the serve session — both run the shadow watch)"
               :task (do (stop-serve-watch!) (td/restart config))}
  dev:attach  {:doc "Attach to tmux dev session"
               :task (td/attach config)}
  dev:logs    {:doc "Show recent output from dev windows"
               :task (td/logs config)}
  dev:status  {:doc "Show dev session status"
               :task (td/status config)}

  clean
  {:doc "Clear shadow-cljs and classpath caches"
   :task (do (shell {:continue true} "find" ".shadow-cljs" "-type" "f" "-delete")
             (shell {:continue true} "find" ".cpcache" "-type" "f" "-delete")
             (println "Caches cleared. Restart shadow-cljs."))}

  build
  {:doc "Compile the CLI (node-script) target"
   :task (shell "npx shadow-cljs compile main")}

  watch
  {:doc "Watch-compile the CLI target with hot reload"
   :task (shell "npx shadow-cljs watch main")}

  web:build
  {:doc "Compile the web client (browser) target"
   :task (shell "npx shadow-cljs compile web")}

  web:watch
  {:doc "Watch-compile the web client with hot reload"
   :task (shell "npx shadow-cljs watch web")}

  watch:all
  {:doc "Watch both CLI and web targets simultaneously"
   :task (shell "npx shadow-cljs watch main web")}

  test
  {:doc "Compile and run unit tests once. Prints a single line when they all pass, or only the FAIL/ERROR blocks + summary (exit 1); compile errors print the full output. `bb test --full` streams the raw shadow-cljs/cljs.test output instead."
   :task (run-cljs-tests "test")}

  test:e2e
  {:doc "Run the end-to-end scenarios (test/xi/e2e/*_e2e.cljs): real `bun target/main.js` runs in throwaway HOMEs against the scripted fake LLM — never a real model. Uses the target/main.js the shadow watch keeps fresh, and compiles it first when no watch runs. Output like `bb test` (`--full` for raw). See docs/testing.md."
   :task (do (when-not (seq (stray-pids "shadow-cljs watch .*main"))
               (shell "npx shadow-cljs compile main"))
             (run-cljs-tests "e2e"))}

  test:watch
  {:doc "Watch-compile and rerun tests on changes"
   :task (shell "npx shadow-cljs watch test")}

  mcp:bb-example:test
  {:doc "Test the example babashka MCP server (packages/mcp-bb-example), incl. a stdio round trip"
   :task (shell {:dir "packages/mcp-bb-example"} "bb" "test")}

  site:dev
  {:doc "Serve the home page + docs site (site/, rendered from docs/guide) on :4322 with live reload"
   :task (shell {:dir "site"} "bb" "dev")}

  site:build
  {:doc "Build the home page + docs site into site/dist"
   :task (shell {:dir "site"} "bb" "build")}

  dev:url
  {:doc "Print the dev-http URL (XI_PUBLIC_HOST, else Tailscale IP when available, else localhost) on port 8100"
   :task (println (str "http://" (host-ip) ":8100"))}

  dev:personal
  {:doc "Start headless server as the root agent profile (foreground)"
   :task (shell "bun target/main.js server --headless --agent root")}

  serve:personal
  {:doc "Start tmux personal-agent serve session (port 7475)"
   :task (do (td/start (assoc pa-serve-config :print [(str "Web: http://" (host-ip) ":7475")]))
             (td/attach pa-serve-config))}

  serve:personal:stop
  {:doc "Stop tmux personal-agent serve session"
   :task (td/stop pa-serve-config)}

  serve:personal:restart
  {:doc "Restart tmux personal-agent serve session"
   :task (td/restart (assoc pa-serve-config :print [(str "Web: http://" (host-ip) ":7475")]))}

  serve
  {:doc "Start tmux serve session (stops the dev session — both run the shadow watch)"
   :task (do (stop-dev-watch!)
             (td/start (assoc serve-config :print [(str "Web: http://" (host-ip) ":7474")]))
             (td/attach serve-config))}

  serve:stop
  {:doc "Stop tmux serve session (also reaps leaked headless :7474 servers)"
   :task (do (td/stop serve-config)
             (reap-stray-serve!))}

  serve:pending
  {:doc "List clients waiting for pairing approval"
   :task (let [pending (read-xi-edn "pending-clients.edn")]
           (if (empty? pending)
             (println "No pending clients.")
             (doseq [[code {:keys [client-name platform requested-at]}] pending]
               (println (format "  %s  %s (%s)  requested %s"
                                code (or client-name "unknown") (or platform "?")
                                (fmt-ts requested-at))))))}

  serve:approve
  {:doc "Approve a pending client by pairing code: bb serve:approve <code>"
   :task (let [code (first *command-line-args*)
               pending (read-xi-edn "pending-clients.edn")
               entry (get pending code)]
           (cond
             (nil? code)
             (do (println "usage: bb serve:approve <code>   (see bb serve:pending)")
                 (System/exit 1))

             (nil? entry)
             (do (println (str "No pending client with code " code "."))
                 (when (seq pending)
                   (println "Pending codes:" (clojure.string/join ", " (keys pending))))
                 (System/exit 1))

             :else
             (do (write-xi-edn "clients.edn"
                               (assoc (read-xi-edn "clients.edn")
                                      (:client-key entry)
                                      {:name        (:client-name entry)
                                       :platform    (:platform entry)
                                       :approved-at (System/currentTimeMillis)}))
                 (write-xi-edn "pending-clients.edn" (dissoc pending code))
                 (println (str "Approved " (or (:client-name entry) "unknown")
                               " (" code ") — the server admits it within ~2s.")))))}

  serve:clients
  {:doc "List approved clients"
   :task (let [clients (read-xi-edn "clients.edn")]
           (if (empty? clients)
             (println "No approved clients (the local TUI key is trusted implicitly).")
             (doseq [[k {:keys [name platform approved-at last-seen]}] clients]
               (println (format "  %s…  %s (%s)  approved %s%s"
                                (subs k 0 (min 8 (count k)))
                                (or name "unknown") (or platform "?")
                                (fmt-ts approved-at)
                                (if last-seen (str "  last seen " (fmt-ts last-seen)) ""))))))}

  serve:revoke
  {:doc "Revoke an approved client by key prefix or name: bb serve:revoke <prefix|name>"
   :task (let [q (first *command-line-args*)
               clients (read-xi-edn "clients.edn")
               hits (filter (fn [[k {:keys [name]}]]
                              (or (and q (clojure.string/starts-with? k q))
                                  (= name q)))
                            clients)]
           (cond
             (nil? q)
             (do (println "usage: bb serve:revoke <key-prefix|name>   (see bb serve:clients)")
                 (System/exit 1))

             (empty? hits)
             (do (println (str "No approved client matches " q ".")) (System/exit 1))

             (> (count hits) 1)
             (do (println "Ambiguous — matches:")
                 (doseq [[k {:keys [name]}] hits]
                   (println "  " (subs k 0 8) "…" (or name "unknown")))
                 (System/exit 1))

             :else
             (let [[k {:keys [name]}] (first hits)]
               (write-xi-edn "clients.edn" (dissoc clients k))
               (println (str "Revoked " (or name "unknown")
                             " — applies to new connections (restart the server to drop live ones).")))))}

  serve:restart
  {:doc "Restart tmux serve session (stops the dev session, reaps leaked headless :7474 servers first)"
   :task (do (stop-dev-watch!)
             (reap-stray-serve!)
             (td/restart (assoc serve-config :print [(str "Web: http://" (host-ip) ":7474")])))}

  serve:await-build
  {:doc "Block until the shadow watch writes a fresh target/main.js (max 180s) — the serve session's server window runs this before starting bun"
   :task (let [f        (clojure.java.io/file "target/main.js")
               t0       (System/currentTimeMillis)
               deadline (+ t0 180000)]
           (println "[xi] waiting for the shadow watch to build target/main.js …")
           (loop []
             (cond
               (> (.lastModified f) t0)
               (println "[xi] fresh build — starting the server")

               (> (System/currentTimeMillis) deadline)
               (println "[xi] no fresh build after 180s — starting on the existing target/main.js")

               :else
               (do (Thread/sleep 500) (recur)))))}

  serve:logs
  {:doc "Print the persisted headless server log (/tmp, survives restarts, self-cleans on reboot). Pass a number for line count."
   :task (let [n (or (first *command-line-args*) "120")]
           (println (str "── " serve-log " (last " n " lines; runs delimited by '=== xi-serve start …') ──"))
           (shell {:continue true} "tail" "-n" n serve-log))}

  demo:seed
  {:doc "(Re)build the isolated demo HOME (.demo-home) with seed sessions"
   :task (shell "bun" "scripts/demo-seed.mjs")}

  demo
  {:doc "Seed + start the isolated demo server (port 7476, HOME=.demo-home)"
   :task (do (shell "bun" "scripts/demo-seed.mjs")
             (td/start demo-config))}

  demo:stop
  {:doc "Stop the demo server tmux session (reaps a leaked :7476 server)"
   :task (do (td/stop demo-config) (reap-stray-demo!))}

  demo:restart
  {:doc "Re-seed .demo-home and restart the demo server (picks up server-side changes)"
   :task (do (shell "bun" "scripts/demo-seed.mjs")
             (td/stop demo-config)
             (reap-stray-demo!)
             (td/start demo-config))}

  demo:logs
  {:doc "Show recent output from the demo server window"
   :task (td/logs demo-config {:lines 40})}

  package
  {:doc "Assemble the npm package in dist/pkg from release builds (the dev watch is left alone) and pack it to dist/<name>-<version>.tgz. `bb package --no-pack` only stages."
   :task (apply shell "bun" "scripts/build-package.mjs" *command-line-args*)}

  package:publish
  {:doc "Publish the npm package: run `bb package`, then `npm publish` the tarball it produced (dist/<name>-<version>.tgz, public access). `--no-build` publishes the existing tarball. Needs `npm login` once."
   :requires ([babashka.fs :as fs]
              [cheshire.core :as json])
   :task (let [{:keys [name version]} (json/parse-string (slurp "package.json") true)
               ;; ./ matters: npm reads a bare dist/x.tgz as a GitHub owner/repo shorthand
               tgz (str "./dist/" name "-" version ".tgz")]
           (when-not (some #{"--no-build"} *command-line-args*)
             (shell "bun" "scripts/build-package.mjs"))
           (when-not (fs/exists? tgz)
             (throw (ex-info (str "no tarball at " tgz " — run bb package first") {})))
           (shell "npm" "publish" tgz "--access" "public"))}

  package:serve
  {:doc "Try the npm package like a user gets it: pack it, install the tarball into dist/try and run the installed xi as a foreground headless server (Ctrl-C stops it; port 7477, isolated HOME in dist/try/home). `--port N` changes the port, `--no-build` reuses the existing tarball."
   :task (apply shell "bun" "scripts/try-package.mjs" *command-line-args*)}

  package:docker
  {:doc "One shot: try the npm package on a clean Bun container (build, recreate, wait, Claude login). Subcommands: `approve <code>` pairs a browser, `login`, `down [--fresh]`. Port 7478 (`--port N`); `--no-build` reuses dist/*.tgz; `--fresh` forgets login and pairings."
   :task (apply shell "bun" "scripts/try-package-docker.mjs" *command-line-args*)}

  treesitter:build
  {:doc "Rebuild resources/treesitter (web-tree-sitter runtime + WASM grammars) from its manifest.json; optionally only the named grammars. $TREE_SITTER overrides the tree-sitter command (e.g. \"steam-run tree-sitter\" on NixOS)."
   :task (apply shell "bun" "scripts/build-treesitter-wasm.mjs" *command-line-args*)}

  claude:build
  {:doc "Force a nix build of the pinned Claude CLI (packages/providers/anthropic/nix) to the packages/providers/anthropic/claude out-link. Optional: the runner builds it itself when it is missing or not the pinned version."
   :task (do (shell "nix" "build" "path:./packages/providers/anthropic/nix#claude-code"
                    "-o" "packages/providers/anthropic/claude")
             (shell "packages/providers/anthropic/claude/bin/claude" "--version"))}

  claude:update
  {:doc "Pin the Claude CLI to the latest upstream release (or `bb claude:update <version>`): rewrites packages/providers/anthropic/nix/claude-code-manifest.json and rebuilds packages/providers/anthropic/claude. Takes effect on the next turn (runners are spawned per turn)."
   :task (let [base "https://downloads.claude.ai/claude-code-releases"
               version (or (first *command-line-args*)
                           (clojure.string/trim
                            (:out (shell {:out :string} "curl" "-fsSL" (str base "/latest")))))
               manifest (:out (shell {:out :string} "curl" "-fsSL"
                                     (str base "/" version "/manifest.zst.json")))]
           (spit "packages/providers/anthropic/nix/claude-code-manifest.json" manifest)
           (println (str "Pinned Claude CLI " version " → packages/providers/anthropic/nix/claude-code-manifest.json"))
           (run 'claude:build))}

  demo:key
  {:doc "Print the demo client key + the localStorage snippet to install it"
   :task (let [k "demo00000000000000000000000000000000000000000000000000000000demo"]
           (println (str "client key: " k))
           (println (str "localStorage.setItem('xi-client-key', '" k "')")))}

  check
  {:doc "Inspect all Xi processes (ports, server + shadow procs, tmux pane logs) AND print agent guidance: what runs where + which bb task to use. Run before starting/stopping anything."
   :task (do
           (println "── Listening ports (7474 main · 7475 personal · 7476 demo · 8100 dev-http · 9630 shadow) ──")
           (shell {:continue true} "bash" "-c"
                  "ss -tlnp 2>/dev/null | grep -E ':(7474|7475|7476|8100|9630)\\b' || echo '  none listening'")
           (println)
           (println "── Headless server processes (bun) ──")
           (shell {:continue true} "bash" "-c"
                  "pgrep -af '[b]un .*target/main.js server' || echo '  none'")
           (println)
           (println "── shadow-cljs watch processes (java classpath line elided) ──")
           (shell {:continue true} "bash" "-c"
                  "pgrep -af '[s]hadow-cljs' | grep -E 'watch' | grep -v 'clojure.main' || echo '  none'")
           (println)
           (println "=== xi session (bb dev — standalone watch) ===")
           (td/status config)
           (td/logs config {:lines 40})
           (println "=== xi-serve session (bb serve — watch + headless server) ===")
           (td/status serve-config)
           (td/logs serve-config {:lines 40})
           (println "=== xi-pa session (bb serve:personal — personal agent) ===")
           (td/status pa-serve-config)
           (td/logs pa-serve-config {:lines 40})
           (println "=== xi-demo session (bb demo — isolated seed data, port 7476) ===")
           (td/status demo-config)
           (td/logs demo-config {:lines 20})
           (println)
           (println "── How to act on this (agents: read before starting/stopping anything) ──")
           (println "  Never start services by hand (no raw `bun target/main.js ...`,")
           (println "  no `npx shadow-cljs ...`). Only the bb tasks manage processes so the")
           (println "  tmux sessions stay consistent. Map of what runs where:")
           (println)
           (println "  port 7474  main server      session xi-serve  bb serve   / serve:restart / serve:stop")
           (println "  port 7475  personal agent   session xi-pa     bb serve:personal[:restart|:stop]")
           (println "  port 7476  demo (seed data)  session xi-demo   bb demo / demo:restart / demo:stop")
           (println "  shadow watch (main+web)     session xi-serve  auto-compiles on save; no manual build")
           (println "  standalone watch (no srv)   session xi        bb dev / dev:restart / dev:stop")
           (println "  (xi and xi-serve both run the shadow watch — starting/restarting one stops the other)")
           (println)
           (println "  - port 7474 already listening? Don't start a server — use http://localhost:7474.")
           (println "  - changed server-side cljs (xi.server/core/agent/ext/provider)? bb serve:restart.")
           (println "  - changed web client cljs? Just refresh the browser (hot-reload).")
           (println "  - need logs? `bb serve:logs` (/tmp/xi-serve.log, survives restarts),")
           (println "    bb dev:logs / the serve:* panes above, or `bb check` again.")
           (println "  - never `kill <pid>` a watch/server — use the matching bb *:stop / *:restart task."))}}}
