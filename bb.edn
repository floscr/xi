{:deps {tmux-dev/tmux-dev {:git/url "https://git.example.com/floscr/tmux-dev"
                            :git/sha "78a82846116d13f05c3ddd9c5d1c4639b6c3538a"}}
 :tasks
 {:requires ([tmux-dev.core :as td]
             [clojure.edn :as edn])
  :init (do
          (defn xi-config-file [name]
            (str (System/getProperty "user.home") "/.config/xi/" name))
          (defn read-xi-edn [name]
            (let [f (java.io.File. (xi-config-file name))]
              (if (.exists f) (edn/read-string (slurp f)) {})))
          (defn write-xi-edn [name m]
            (.mkdirs (.getParentFile (java.io.File. (xi-config-file name))))
            (spit (xi-config-file name) (str (pr-str m) "\n")))
          (defn fmt-ts [ms]
            (when ms (str (java.util.Date. (long ms)))))
          (def config {:session "xi"
                       :windows [["watch" "npx shadow-cljs watch main web"]]
                       :print   ["Web: http://localhost:7474"]})
          (def serve-config {:session "xi-serve"
                             :windows [["watch" "npx shadow-cljs watch main web"]
                                       ["server" "bun target/main.js server --headless"]]
                             :env-file ".env"})
          (def pa-serve-config {:session "xi-pa"
                                :windows [["server" "bun target/main.js server --headless --personal-agent-only --port 7475"]]})
          ;; Isolated demo server (port 7476). HOME is redirected at .demo-home
          ;; (built by scripts/demo-seed.mjs) so it never sees the real active
          ;; session — see docs/demo.md. Reuses the target/main.js compiled by
          ;; the main watch (bb dev / bb serve).
          (def demo-home (str (System/getProperty "user.dir") "/.demo-home"))
          (def demo-config {:session "xi-demo"
                            :windows [["server" (str "HOME=" demo-home
                                                     " bun target/main.js server --headless --port 7476")]]
                            :print ["Demo web: http://localhost:7476"]})
          ;; Reap leaked dev :7474 headless servers. `td/*` only manage the tmux
          ;; session, and the systemd xi-serve unit uses KillMode=process, so
          ;; detached/orphaned `bun target/main.js server --headless` processes
          ;; leak across restarts and keep :7474 occupied. The personal-agent
          ;; (--port 7475), demo (--port 7476) and system xi-agent
          ;; (--personal-agent-only) servers all carry --port/--personal-agent-only
          ;; and are deliberately excluded.
          ;; The `--headless$` end-anchor matches ONLY the dev serve cmdline
          ;; (`bun target/main.js server --headless`); personal/demo/xi-agent
          ;; carry trailing --port/--personal-agent-only args so they don't
          ;; match. pgrep returns just the PIDs, so no cmdline parsing is
          ;; needed (bb.edn is EDN — no #(...) / #"..." reader macros).
          (defn stray-serve-pids []
            (let [{:keys [out]} (shell {:out :string :continue true}
                                       "pgrep" "-f" "target/main.js server --headless$")]
              (remove clojure.string/blank?
                      (clojure.string/split-lines (or out "")))))
          (defn reap-stray-serve! []
            (when-let [pids (seq (stray-serve-pids))]
              (println (str "Reaping " (count pids) " stray xi serve process(es): "
                            (clojure.string/join " " pids)))
              (apply shell {:continue true} "kill" "-9" pids)
              (Thread/sleep 500))))

  dev         {:doc "Start tmux dev session"
               :task (td/start config)}
  dev:stop    {:doc "Stop tmux dev session"
               :task (td/stop config)}
  dev:restart {:doc "Restart tmux dev session"
               :task (td/restart config)}
  dev:attach  {:doc "Attach to tmux dev session"
               :task (td/attach config)}
  dev:logs    {:doc "Show recent output from dev windows"
               :task (td/logs config)}
  dev:status  {:doc "Show dev session status"
               :task (td/status config)}

  clean
  {:doc "Clear shadow-cljs and classpath caches"
   :task (do (shell {:continue true} "find" ".shadow-cljs" "-type" "f" "-delete")
             (shell {:continue true} "find" ".cpcache" "-type" "f" "-delete")
             (println "Caches cleared. Restart shadow-cljs."))}

  build
  {:doc "Compile the CLI (node-script) target"
   :task (shell "npx shadow-cljs compile main")}

  watch
  {:doc "Watch-compile the CLI target with hot reload"
   :task (shell "npx shadow-cljs watch main")}

  web:build
  {:doc "Compile the web client (browser) target"
   :task (shell "npx shadow-cljs compile web")}

  web:watch
  {:doc "Watch-compile the web client with hot reload"
   :task (shell "npx shadow-cljs watch web")}

  watch:all
  {:doc "Watch both CLI and web targets simultaneously"
   :task (shell "npx shadow-cljs watch main web")}

  test
  {:doc "Compile and run unit tests once"
   :task (shell "npx shadow-cljs compile test")}

  test:watch
  {:doc "Watch-compile and rerun tests on changes"
   :task (shell "npx shadow-cljs watch test")}

  chrome:sync-tools
  {:doc "Regenerate resources/chrome/tools.edn from chrome-devtools-mcp's live tools/list"
   :task (shell "node" "scripts/sync-chrome-tools.mjs")}

  picker:build
  {:doc "Compile the element-picker (squint → esbuild) to resources/element-picker/picker.js"
   :task (let [dir "resources/element-picker"]
           (shell {:dir dir} "npx" "squint" "compile")
           (shell {:dir dir} "npx" "esbuild" ".compiled/picker.mjs"
                  "--bundle" "--format=iife" "--minify" "--outfile=picker.js"
                  "--banner:js=/* GENERATED from picker.cljs by `bb picker:build` — do not edit. */"))}

  design:build
  {:doc "Compile the design-mode browser script (squint → esbuild) to resources/design-mode/design.js"
   :task (let [dir "resources/design-mode"]
           (shell {:dir dir} "npx" "squint" "compile")
           (shell {:dir dir} "npx" "esbuild" ".compiled/design.mjs"
                  "--bundle" "--format=iife" "--minify" "--outfile=design.js"
                  "--banner:js=/* GENERATED from design.cljs by `bb design:build` — do not edit. */"))}

  style-editor:build
  {:doc "Compile the style-editor (squint → esbuild) to resources/style-editor/style-editor.js"
   :task (let [dir "resources/style-editor"]
           (shell {:dir dir} "npx" "squint" "compile")
           (shell {:dir dir} "npx" "esbuild" ".compiled/style-editor.mjs"
                  "--bundle" "--format=iife" "--minify" "--outfile=style-editor.js"
                  "--banner:js=/* GENERATED from style-editor.cljs by `bb style-editor:build` — do not edit. */"))}

  dev:url
  {:doc "Print Tailscale IP with frontend port"
   :task (let [ip (-> (shell {:out :string} "tailscale ip -4") :out clojure.string/trim)]
           (println (str "http://" ip ":8100")))}

  dev:personal
  {:doc "Start headless server in personal agent mode (foreground)"
   :task (shell "bun target/main.js server --headless --personal-agent-only")}

  serve:personal
  {:doc "Start tmux personal-agent serve session (port 7475)"
   :task (let [ip (-> (shell {:out :string} "tailscale ip -4") :out clojure.string/trim)]
           (td/start (assoc pa-serve-config :print [(str "Web: http://" ip ":7475")]))
           (td/attach pa-serve-config))}

  serve:personal:stop
  {:doc "Stop tmux personal-agent serve session"
   :task (td/stop pa-serve-config)}

  serve:personal:restart
  {:doc "Restart tmux personal-agent serve session"
   :task (let [ip (-> (shell {:out :string} "tailscale ip -4") :out clojure.string/trim)]
           (td/restart (assoc pa-serve-config :print [(str "Web: http://" ip ":7475")])))}

  serve
  {:doc "Start tmux serve session with Tailscale URL"
   :task (let [ip (-> (shell {:out :string} "tailscale ip -4") :out clojure.string/trim)]
           (td/start (assoc serve-config :print [(str "Web: http://" ip ":7474")]))
           (td/attach serve-config))}

  serve:stop
  {:doc "Stop tmux serve session (also reaps leaked headless :7474 servers)"
   :task (do (td/stop serve-config)
             (reap-stray-serve!))}

  serve:pending
  {:doc "List clients waiting for pairing approval"
   :task (let [pending (read-xi-edn "pending-clients.edn")]
           (if (empty? pending)
             (println "No pending clients.")
             (doseq [[code {:keys [client-name platform requested-at]}] pending]
               (println (format "  %s  %s (%s)  requested %s"
                                code (or client-name "unknown") (or platform "?")
                                (fmt-ts requested-at))))))}

  serve:approve
  {:doc "Approve a pending client by pairing code: bb serve:approve <code>"
   :task (let [code (first *command-line-args*)
               pending (read-xi-edn "pending-clients.edn")
               entry (get pending code)]
           (cond
             (nil? code)
             (do (println "usage: bb serve:approve <code>   (see bb serve:pending)")
                 (System/exit 1))

             (nil? entry)
             (do (println (str "No pending client with code " code "."))
                 (when (seq pending)
                   (println "Pending codes:" (clojure.string/join ", " (keys pending))))
                 (System/exit 1))

             :else
             (do (write-xi-edn "clients.edn"
                               (assoc (read-xi-edn "clients.edn")
                                      (:client-key entry)
                                      {:name        (:client-name entry)
                                       :platform    (:platform entry)
                                       :approved-at (System/currentTimeMillis)}))
                 (write-xi-edn "pending-clients.edn" (dissoc pending code))
                 (println (str "Approved " (or (:client-name entry) "unknown")
                               " (" code ") — the server admits it within ~2s.")))))}

  serve:clients
  {:doc "List approved clients"
   :task (let [clients (read-xi-edn "clients.edn")]
           (if (empty? clients)
             (println "No approved clients (the local TUI key is trusted implicitly).")
             (doseq [[k {:keys [name platform approved-at last-seen]}] clients]
               (println (format "  %s…  %s (%s)  approved %s%s"
                                (subs k 0 (min 8 (count k)))
                                (or name "unknown") (or platform "?")
                                (fmt-ts approved-at)
                                (if last-seen (str "  last seen " (fmt-ts last-seen)) ""))))))}

  serve:revoke
  {:doc "Revoke an approved client by key prefix or name: bb serve:revoke <prefix|name>"
   :task (let [q (first *command-line-args*)
               clients (read-xi-edn "clients.edn")
               hits (filter (fn [[k {:keys [name]}]]
                              (or (and q (clojure.string/starts-with? k q))
                                  (= name q)))
                            clients)]
           (cond
             (nil? q)
             (do (println "usage: bb serve:revoke <key-prefix|name>   (see bb serve:clients)")
                 (System/exit 1))

             (empty? hits)
             (do (println (str "No approved client matches " q ".")) (System/exit 1))

             (> (count hits) 1)
             (do (println "Ambiguous — matches:")
                 (doseq [[k {:keys [name]}] hits]
                   (println "  " (subs k 0 8) "…" (or name "unknown")))
                 (System/exit 1))

             :else
             (let [[k {:keys [name]}] (first hits)]
               (write-xi-edn "clients.edn" (dissoc clients k))
               (println (str "Revoked " (or name "unknown")
                             " — applies to new connections (restart the server to drop live ones).")))))}

  serve:restart
  {:doc "Restart tmux serve session (reaps leaked headless :7474 servers first)"
   :task (let [ip (-> (shell {:out :string} "tailscale ip -4") :out clojure.string/trim)]
           (reap-stray-serve!)
           (td/restart (assoc serve-config :print [(str "Web: http://" ip ":7474")])))}

  demo:seed
  {:doc "(Re)build the isolated demo HOME (.demo-home) with seed sessions"
   :task (shell "bun" "scripts/demo-seed.mjs")}

  demo
  {:doc "Seed + start the isolated demo server (port 7476, HOME=.demo-home)"
   :task (do (shell "bun" "scripts/demo-seed.mjs")
             (td/start demo-config))}

  demo:stop
  {:doc "Stop the demo server tmux session"
   :task (td/stop demo-config)}

  demo:restart
  {:doc "Re-seed .demo-home and restart the demo server (picks up server-side changes)"
   :task (do (shell "bun" "scripts/demo-seed.mjs")
             (td/restart demo-config))}

  demo:logs
  {:doc "Show recent output from the demo server window"
   :task (td/logs demo-config {:lines 40})}

  treesitter:install
  {:doc "nix-build the xi-treesitter CLI + grammars into ~/.config/xi/treesitter"
   :task (shell "nix-build" "native/xi-treesitter"
                "-o" (str (System/getProperty "user.home") "/.config/xi/treesitter"))}

  demo:key
  {:doc "Print the demo client key + the localStorage snippet to install it"
   :task (let [k "demo00000000000000000000000000000000000000000000000000000000demo"]
           (println (str "client key: " k))
           (println (str "localStorage.setItem('xi-client-key', '" k "')")))}

  check
  {:doc "Inspect all Xi processes (ports, server + shadow procs, tmux pane logs) AND print agent guidance: what runs where + which bb task to use. Run before starting/stopping anything."
   :task (do
           (println "── Listening ports (7474 main · 7475 personal · 7476 demo · 8100 dev-http · 9630 shadow) ──")
           (shell {:continue true} "bash" "-c"
                  "ss -tlnp 2>/dev/null | grep -E ':(7474|7475|7476|8100|9630)\\b' || echo '  none listening'")
           (println)
           (println "── Headless server processes (bun) ──")
           (shell {:continue true} "bash" "-c"
                  "pgrep -af '[b]un .*target/main.js server' || echo '  none'")
           (println)
           (println "── shadow-cljs watch processes (java classpath line elided) ──")
           (shell {:continue true} "bash" "-c"
                  "pgrep -af '[s]hadow-cljs' | grep -E 'watch' | grep -v 'clojure.main' || echo '  none'")
           (println)
           (println "=== xi session (bb dev — standalone watch) ===")
           (td/status config)
           (td/logs config {:lines 40})
           (println "=== xi-serve session (bb serve — watch + headless server) ===")
           (td/status serve-config)
           (td/logs serve-config {:lines 40})
           (println "=== xi-pa session (bb serve:personal — personal agent) ===")
           (td/status pa-serve-config)
           (td/logs pa-serve-config {:lines 40})
           (println "=== xi-demo session (bb demo — isolated seed data, port 7476) ===")
           (td/status demo-config)
           (td/logs demo-config {:lines 20})
           (println)
           (println "── How to act on this (agents: read before starting/stopping anything) ──")
           (println "  Never start services by hand (no raw `bun target/main.js ...`,")
           (println "  no `npx shadow-cljs ...`). Only the bb tasks manage processes so the")
           (println "  tmux sessions stay consistent. Map of what runs where:")
           (println)
           (println "  port 7474  main server      session xi-serve  bb serve   / serve:restart / serve:stop")
           (println "  port 7475  personal agent   session xi-pa     bb serve:personal[:restart|:stop]")
           (println "  port 7476  demo (seed data)  session xi-demo   bb demo / demo:restart / demo:stop")
           (println "  shadow watch (main+web)     session xi-serve  auto-compiles on save; no manual build")
           (println "  standalone watch (no srv)   session xi        bb dev / dev:restart / dev:stop")
           (println)
           (println "  - port 7474 already listening? Don't start a server — use http://localhost:7474.")
           (println "  - changed server-side cljs (xi.server/core/agent/ext/provider)? bb serve:restart.")
           (println "  - changed web client cljs? Just refresh the browser (hot-reload).")
           (println "  - need logs? bb dev:logs / bb serve:* panes above, or `bb check` again.")
           (println "  - never `kill <pid>` a watch/server — use the matching bb *:stop / *:restart task."))}}}
