;; Hand-written (chroma's rust lexer is multi-state; flattening its root state
;; leaves only the shebang rule). The converter leaves this file alone and only
;; re-adds its registry aliases (scripts/convert-chroma-grammars.mjs).
[{:pattern "#![^\\[\\r\\n].*$" :token :comment}
 {:pattern "//.*$" :token :comment}
 {:pattern "/\\*[\\s\\S]*?\\*/" :token :comment}
 {:pattern "#!?\\[[^\\]\\n]*\\]" :token :reader}
 {:pattern "[bc]?r(#*)\"[\\s\\S]*?\"\\1" :token :string}
 {:pattern "[bc]?\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"" :token :string}
 {:pattern "b?'(?:\\\\(?:[nrt\\\\'\"0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F_]{1,6}\\})|[^\\\\'\\n])'" :token :string-char}
 {:pattern "'[A-Za-z_]\\w*" :token :string-symbol}
 {:pattern "r#[A-Za-z_]\\w*" :token :name-var}
 {:pattern "0x[0-9a-fA-F_]+(?:[iu](?:8|16|32|64|128|size))?" :token :number}
 {:pattern "0o[0-7_]+(?:[iu](?:8|16|32|64|128|size))?" :token :number}
 {:pattern "0b[01_]+(?:[iu](?:8|16|32|64|128|size))?" :token :number}
 {:pattern "\\d[\\d_]*(?:\\.(?![.A-Za-z_])[\\d_]*)?(?:[eE][+-]?[\\d_]+)?(?:[iu](?:8|16|32|64|128|size)|f32|f64)?" :token :number}
 {:pattern "\\b(?:fn|let|const|static|struct|enum|union|trait|impl|type|mod)\\b" :token :keyword-decl}
 {:pattern "\\bmacro_rules!" :token :keyword-decl}
 {:pattern "\\b(?:as|async|await|break|continue|dyn|else|extern|for|if|in|loop|match|move|mut|pub|ref|return|unsafe|use|where|while|yield)\\b" :token :keyword}
 {:pattern "\\b(?:true|false|Some|None|Ok|Err)\\b" :token :keyword-special}
 {:pattern "\\b(?:self|Self|super|crate)\\b" :token :name-builtin}
 {:pattern "\\b(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String|Vec|Option|Result|Box|Rc|Arc|Cell|RefCell|HashMap|HashSet|BTreeMap|BTreeSet|VecDeque)\\b" :token :name-builtin}
 {:pattern "(?<=\\bfn\\s+)[A-Za-z_]\\w*" :token :name-fn}
 {:pattern "[A-Za-z_]\\w*!(?!=)" :token :name-builtin}
 {:pattern "[A-Za-z_]\\w*(?=\\s*(?:::\\s*<[^()\\n]*>\\s*)?\\()" :token :name-fn}
 {:pattern "[A-Za-z_]\\w*" :token :name-var}
 {:pattern "\\.\\.[.=]?|->|=>|<<=|>>=|[-+*/%^&|<>=!]=|&&|\\|\\||<<|>>|[-+*/%^!&|<>=?@]" :token :operator}
 {:pattern "::|[\\[\\](){}.,;:#$]" :token :punctuation}
 {:pattern "\\s+" :token :text}]
