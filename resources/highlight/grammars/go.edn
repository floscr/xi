[   {:pattern "//[^\\n]*" :token :comment}
   {:pattern "/\\*[\\s\\S]*?\\*/" :token :comment}
   {:pattern "\\d+\\.\\d*([eE][+\\-]?\\d+)?i?" :token :number}
   {:pattern "\\.\\d+([eE][+\\-]?\\d+)?i?" :token :number}
   {:pattern "0[xX][0-9a-fA-F_]+" :token :number}
   {:pattern "0[oO][0-7_]+" :token :number}
   {:pattern "0[bB][01_]+" :token :number}
   {:pattern "[0-9][0-9_]*i?" :token :number}
   {:pattern "(break|case|chan|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|map|package|range|return|select|struct|switch|type|var)\\b" :token :keyword}
   {:pattern "(true|false|nil|iota)\\b" :token :keyword}
   {:pattern "(bool|byte|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr|any|comparable)\\b" :token :keyword-decl}
   {:pattern "(append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b" :token :name-builtin}
   {:pattern "`[^`]*`" :token :string}
   {:pattern "\"(\\\\.|[^\"])*\"" :token :string}
   {:pattern "'(\\\\.|[^'])'" :token :string-char}
   {:pattern "[a-zA-Z_][a-zA-Z0-9_]*" :token :name-var}
   {:pattern "[{}()\\[\\];,.]" :token :punctuation}
   {:pattern ":=|<-|&&|\\|\\||[<>!=]=|[+\\-*/%&|^]=?|<<|>>|&\\^" :token :operator}
   {:pattern "\\s+" :token :text}]
