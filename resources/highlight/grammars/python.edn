;; Hand-written (chroma's python lexer keeps strings and the def / class /
;; import rules in pushed states; flattening its root state left no string
;; rule and no declaration keywords). The converter leaves this file alone and
;; only re-adds its registry aliases (scripts/convert-chroma-grammars.mjs).
[{:pattern "#.*$" :token :comment}
 {:pattern "(?:[rRbBuUfF]{1,2})?\"\"\"[\\s\\S]*?\"\"\"" :token :string}
 {:pattern "(?:[rRbBuUfF]{1,2})?'''[\\s\\S]*?'''" :token :string}
 {:pattern "(?:[rRbBuUfF]{1,2})?\"(?:\\\\[\\s\\S]|[^\"\\\\\\n])*\"" :token :string}
 {:pattern "(?:[rRbBuUfF]{1,2})?'(?:\\\\[\\s\\S]|[^'\\\\\\n])*'" :token :string}
 {:pattern "@[A-Za-z_][\\w.]*" :token :name-builtin}
 {:pattern "0[xX](?:_?[0-9a-fA-F])+" :token :number}
 {:pattern "0[oO](?:_?[0-7])+" :token :number}
 {:pattern "0[bB](?:_?[01])+" :token :number}
 {:pattern "(?:\\d(?:_?\\d)*\\.(?:\\d(?:_?\\d)*)?|\\.\\d(?:_?\\d)*|\\d(?:_?\\d)*)(?:[eE][+-]?\\d(?:_?\\d)*)?[jJ]?" :token :number}
 {:pattern "\\b(?:def|class|lambda)\\b" :token :keyword-decl}
 {:pattern "\\b(?:import|from|as|if|elif|else|for|while|try|except|finally|with|return|yield|raise|pass|break|continue|del|global|nonlocal|assert|async|await)\\b" :token :keyword}
 {:pattern "\\b(?:True|False|None)\\b" :token :keyword-special}
 {:pattern "\\b(?:and|or|not|in|is)\\b" :token :keyword}
 {:pattern "(?<=\\b(?:def|class)\\s+)[A-Za-z_]\\w*" :token :name-fn}
 {:pattern "\\b(?:self|cls)\\b" :token :name-builtin}
 {:pattern "(?<!\\.)\\b(?:abs|all|any|ascii|bin|bool|breakpoint|bytearray|bytes|callable|chr|classmethod|compile|complex|delattr|dict|dir|divmod|enumerate|eval|exec|filter|float|format|frozenset|getattr|globals|hasattr|hash|help|hex|id|input|int|isinstance|issubclass|iter|len|list|locals|map|max|memoryview|min|next|object|oct|open|ord|pow|print|property|range|repr|reversed|round|set|setattr|slice|sorted|staticmethod|str|sum|super|tuple|type|vars|zip|__import__)\\b" :token :name-builtin}
 {:pattern "(?<!\\.)\\b(?:BaseException|Exception|ArithmeticError|AssertionError|AttributeError|EOFError|FileExistsError|FileNotFoundError|ImportError|IndexError|KeyError|KeyboardInterrupt|LookupError|MemoryError|ModuleNotFoundError|NameError|NotImplementedError|OSError|OverflowError|PermissionError|RecursionError|RuntimeError|StopIteration|SyntaxError|SystemExit|TimeoutError|TypeError|UnboundLocalError|UnicodeError|ValueError|ZeroDivisionError)\\b" :token :name-builtin}
 {:pattern "[A-Za-z_]\\w*(?=\\s*\\()" :token :name-fn}
 {:pattern "[A-Za-z_]\\w*" :token :name-var}
 {:pattern "\\*\\*=?|//=?|->|:=|<<=?|>>=?|[-+*/%&|^=<>!]=?|~" :token :operator}
 {:pattern "[\\[\\](){},;:.]" :token :punctuation}
 {:pattern "\\s+" :token :text}]
