{
  "runtime": { "package": "web-tree-sitter", "version": "0.26.13" },
  "toolchain": "tree-sitter CLI 0.26.x (downloads wasi-sdk 29)",
  "grammars": {
    "bash":       { "repo": "https://github.com/tree-sitter/tree-sitter-bash",       "rev": "v0.25.1" },
    "clojure":    { "repo": "https://github.com/sogaiu/tree-sitter-clojure",         "rev": "e43eff80d17cf34852dcd92ca5e6986d23a7040f" },
    "css":        { "repo": "https://github.com/tree-sitter/tree-sitter-css",        "rev": "v0.25.0" },
    "go":         { "repo": "https://github.com/tree-sitter/tree-sitter-go",         "rev": "v0.25.0" },
    "javascript": { "repo": "https://github.com/tree-sitter/tree-sitter-javascript", "rev": "v0.25.0" },
    "nix":        { "repo": "https://github.com/nix-community/tree-sitter-nix",      "rev": "eabf96807ea4ab6d6c7f09b671a88cd483542840" },
    "python":     { "repo": "https://github.com/tree-sitter/tree-sitter-python",     "rev": "v0.25.0" },
    "rust":       { "repo": "https://github.com/tree-sitter/tree-sitter-rust",       "rev": "v0.24.2" },
    "tsx":        { "repo": "https://github.com/tree-sitter/tree-sitter-typescript", "rev": "v0.23.2", "subdir": "tsx" },
    "typescript": { "repo": "https://github.com/tree-sitter/tree-sitter-typescript", "rev": "v0.23.2", "subdir": "typescript" }
  }
}
