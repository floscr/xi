{:deps true
 :dev-http {8100 {:root "resources/public" :host "0.0.0.0"}}
 :builds
 {:main
  {:target :node-script
   :main xi.cli/main
   :output-to "target/main.js"
   :devtools {:console-support false :log false}
   :compiler-options {:optimizations :simple
                      :reader-features #{:node}}}

  :test
  {:target    :node-test
   :output-to "target/test.js"
   :autorun   true
   :compiler-options {:reader-features #{:node}}}

  ;; End-to-end scenarios (`bb test:e2e`): *-e2e namespaces drive the built
  ;; target/main.js against the scripted fake LLM (test/xi/e2e/).
  :e2e
  {:target    :node-test
   :output-to "target/e2e.js"
   :ns-regexp "-e2e$"
   :autorun   true
   :compiler-options {:reader-features #{:node}}}

  :web
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   ;; :user-ext (SCI + the user-extension evaluator) loads lazily via
   ;; shadow.lazy, only when the server has user web halves (xi.web.user-ext)
   :modules    {:main     {:init-fn xi.web.core/init!}
                :user-ext {:entries [xi.web.user-ext.sci] :depends-on #{:main}}}
   :module-loader true
   ;; No :warnings in the HUD: its fixed overlay covers the bottom of the page
   ;; for as long as a warning stands. Warnings still print in the watch output.
   :devtools   {:after-load xi.web.core/reload!
                :hud #{:errors :progress}}
   :compiler-options {:reader-features #{:browser}}}

  ;; The site's live tours (site/tours/, `bb tour:build`): the web client in
  ;; one release file, target/tour/main.js. No user extensions, so no SCI
  ;; module; :ns-aliases swap out what no tour shows (src/xi/web/tour/stubs/).
  :tour
  {:target     :browser
   :output-dir "target/tour"
   :asset-path "/tour"
   :modules    {:main {:init-fn xi.web.core/init!}}
   :module-loader false
   :build-options {:ns-aliases {cljs.pprint              xi.web.tour.stubs.pprint
                                xi.web.user-ext          xi.web.tour.stubs.user-ext
                                xi.ext.canvas-review.web xi.web.tour.stubs.canvas-review
                                xi.ext.usage.web         xi.web.tour.stubs.usage}}
   :compiler-options {:reader-features #{:browser}}}}}
