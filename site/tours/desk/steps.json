        { "clickText": "Allow", "after": 2500 },
        { "waitText": "covers the doubling and the cap" },
        { "wait": 1200 },
        { "clickText": "edit src/upload.ts", "within": "summary", "contains": true },
        { "wait": 2500 },
        { "clickText": "edit src/upload.ts", "within": "summary" }
      ]
