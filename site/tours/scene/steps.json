{
  "gates": ["auth/hello", "cwd/agents-files", "room/join", "input/submit", "ui/dialog-response",
            "command/run", "subagent/spawn"],
  "steps": [
    { "chapter": "Prompt", "about": "Ask in plain words" },
    { "wait": 1200 },
    { "click": "[data-nav=\"dir:/home/dev/acme-web\"] button[title=\"New chat\"]" },
    { "wait": 400 },
    { "type": "textarea[placeholder=\"Message…\"]",
      "text": "Which of our modules are the biggest? Show me in 3D." },
    { "wait": 300 },
    { "enter": "textarea" },
    { "waitText": "allow running" },
    { "chapter": "Allow a clj call", "about": "Approve what the agent runs" },
    { "clickText": "Allow", "after": 2500 },
    { "waitText": "One box per module" },
    { "chapter": "3D block", "about": "The answer as a 3D scene" },
    { "appOrbit": -0.55, "after": 800 },
    { "wait": 500 },
    { "chapter": "Pick and ask", "about": "Click a module, ask about it" },
    { "app": "charts.ts" },
    { "wait": 1000 },
    { "waitText": "asks me about that module" },
    { "app": "#ask" },
    { "wait": 1200 },
    { "enter": "textarea" },
    { "waitText": "already does with" },
    { "chapter": "Make the change", "about": "The agent edits the code" },
    { "wait": 900 },
    { "type": "textarea[placeholder=\"Message…\"]", "text": "Do it." },
    { "wait": 200 },
    { "enter": "textarea" },
    { "waitText": "shows the change" },
    { "chapter": "Diff", "about": "Review every change" },
    { "wait": 2200 },
    { "type": "textarea[placeholder=\"Message…\"]", "text": "/diff" },
    { "wait": 400 },
    { "enter": "textarea" },
    { "wait": 1600 },
    { "chapter": "Explain", "about": "Select lines, get them explained" },
    { "clickText": "compactFormat = new", "within": ".diff-tab .diff-line", "contains": true },
    { "clickText": "return compactFormat.format", "within": ".diff-tab .diff-line", "contains": true, "after": 400 },
    { "clickText": "Explain", "within": ".diff-sel-pill button", "contains": true, "after": 600 },
    { "waitText": "upper-case" },
    { "wait": 3000 },
    { "click": ".buffer-menu-trigger" },
    { "click": ".buffer-menu-item[title=\"Chat\"]", "after": 500 },
    { "wait": 2500 }
  ],
  "variants": {
    "phone": {
      "pointer": "touch",
      "steps": [
        { "chapter": "Prompt" },
        { "wait": 1200 },
        { "click": "main [data-nav=\"dir:/home/dev/acme-web\"] button[title=\"New chat\"]" },
        { "wait": 400 },
        { "type": "textarea[placeholder=\"Message…\"]",
          "text": "Which of our modules are the biggest? Show me in 3D." },
        { "wait": 300 },
        { "enter": "textarea" },
        { "waitText": "allow running" },
        { "chapter": "Allow a clj call" },
        { "clickText": "Allow", "after": 2500 },
        { "waitText": "One box per module" },
        { "chapter": "3D block" },
        { "appOrbit": -0.55, "after": 800 },
        { "wait": 500 },
        { "chapter": "Pick and ask" },
        { "app": "charts.ts" },
        { "wait": 1000 },
        { "waitText": "asks me about that module" },
        { "app": "#ask" },
        { "wait": 1200 },
        { "enter": "textarea" },
        { "waitText": "already does with" },
        { "chapter": "Make the change" },
        { "wait": 900 },
        { "type": "textarea[placeholder=\"Message…\"]", "text": "Do it." },
        { "wait": 200 },
        { "enter": "textarea" },
        { "waitText": "shows the change" },
        { "chapter": "Diff" },
        { "wait": 2200 },
        { "type": "textarea[placeholder=\"Message…\"]", "text": "/diff" },
        { "wait": 400 },
        { "enter": "textarea" },
        { "wait": 1600 },
        { "chapter": "Explain" },
        { "clickText": "compactFormat = new", "within": ".diff-tab .diff-line", "contains": true },
        { "clickText": "return compactFormat.format", "within": ".diff-tab .diff-line", "contains": true, "after": 400 },
        { "clickText": "Explain", "within": ".diff-sel-pill button", "contains": true, "after": 600 },
        { "waitText": "upper-case" },
        { "wait": 3000 },
        { "click": ".buffer-menu-trigger" },
        { "click": ".buffer-menu-item[title=\"Chat\"]", "after": 500 },
        { "wait": 2500 }
      ]
    }
  }
}
