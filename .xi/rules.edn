;; Xi's own permission rules for this repository — above ~/.config/xi/rules.edn
;; and the built-in defaults, below the hardened tier.
;; Syntax: docs/guide/rules.md, docs/guide/rules-reference.md
{:type    :xi/rules
 :version 1
 :rules
 [;; `bb release` publishes to npm, pushes and deploys the site: the user runs
  ;; it, never an agent.
  {:match  {:tool #{:task :sh} :task {"bb" "release"}}
   :action {:type :deny :message "Releasing is the user's job: give them the `bb release` command instead."}}

  ;; bb.edn is always trusted. The trust store is content-addressed, so every
  ;; edit to bb.edn re-asked before the next bb task (run_task, or clj
  ;; (sh "bb" <task>)). Only an untrusted bb.edn is matched, and only a task
  ;; bb.edn defines (`:task`; no `bb -e`, no script file). serve:restart/stop
  ;; are left to the default task-trust ask; with a trusted bb.edn they reach
  ;; the server-control ask as usual.
  {:match  {:tool              :task
            :task-file-trusted false
            :task              {"bb" ["!serve:restart" "!serve:stop"]}}
   :action {:type :allow}}

  ;; tmux, read-only subcommands only: inspecting the xi / xi-serve / xi-demo /
  ;; xi-site sessions. A `#(` (a format's shell command) or a `;` argument
  ;; (a chained tmux command) is left to the default ask.
  {:match  {:tool    :sh
            :cli     "tmux"
            :command #"^(?!.*(?:#\(|;))tmux (?:-[LS] \S+ )?(?:list-sessions|ls|list-windows|lsw|list-panes|lsp|list-clients|lsc|has-session|has|capture-pane|capturep|display-message|display)(?: |$)"}
   :action {:type :allow}}]}
